      "binding": "DB",
      "database_name": "english-grammar-lab-db",
      "database_id": "130b3522-cbce-43f1-8e75-89add82644f6",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "33b4011a5d5897c4f8fd69111f4e8e18"
}
